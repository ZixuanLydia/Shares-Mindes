{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "shareId": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/)"
        },
        "week04": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['version', 'payload', 'updatedAt'])",
          "version": {
            ".validate": "newData.val() === 2"
          },
          "payload": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3000000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        },
        "week05": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['version', 'payload', 'updatedAt'])",
          "version": {
            ".validate": "newData.val() === 2"
          },
          "payload": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3000000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "shares": {
      "$shareId": {
        ".read": "data.child('enabled').val() === true || (auth != null && data.child('ownerUid').val() === auth.uid)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('shareId').val() === $shareId && newData.exists() && newData.child('ownerUid').val() === auth.uid && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['version', 'payload', 'ownerUid', 'enabled', 'updatedAt'])",
        "version": {
          ".validate": "newData.val() === 2"
        },
        "payload": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3000000"
        },
        "ownerUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "enabled": {
          ".validate": "newData.isBoolean()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "social05": {
      "stories": {
        ".read": "query.orderByChild === 'updatedAt' && query.limitToLast != null && query.limitToLast <= 20",
        ".indexOn": [
          "updatedAt"
        ],
        "$uid": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['version','payload','updatedAt'])",
          "version": {
            ".validate": "newData.val() === 2"
          },
          "payload": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "replies": {
        "$story": {
          ".read": "root.child('social05/stories').child($story).exists() && query.orderByChild === 'updatedAt' && query.limitToLast != null && query.limitToLast <= 20",
          ".indexOn": [
            "updatedAt"
          ],
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('social05/stories').child($story).exists())",
            ".validate": "newData.hasChildren(['nickname','text','updatedAt'])",
            "nickname": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
